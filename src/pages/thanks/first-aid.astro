---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Training request received | KRE Security"
  description="Thank you for requesting First Aid, CPR, and AED training from KRE Security."
  noIndex={true}
>
  <section class="relative isolate py-[96px]" data-ps="src/pages/thanks/first-aid.astro:section">
    <div class="max-w-[720px] mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Training division</span>
      </div>
      <h1 class="text-[40px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px] mb-4">
        We received your training request.
      </h1>
      <p class="text-[#a8a29e] text-[17px] leading-[28px] mb-8">
        A KRE instructor will follow up on First Aid, CPR, and AED training for your group. For urgent scheduling, call 610-562-0971.
      </p>
      <a href="/first-aid-training/" class="inline-flex bg-[#f5bd14] text-[#0a0a0a] font-bold text-[15px] px-8 py-4 rounded-[10px] no-underline hover:bg-[#e0ab10]">
        Back to First Aid Training
      </a>
    </div>
  </section>
</BaseLayout>
