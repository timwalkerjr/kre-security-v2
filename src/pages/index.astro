---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Services from '@/components/home/Services.astro';
import Trust from '@/components/home/Trust.astro';
import Advantages from '@/components/home/Advantages.astro';
import Coverage from '@/components/home/Coverage.astro';
import QuoteForm from '@/components/home/QuoteForm.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phone.primary,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.streetAddress,
    addressLocality: SITE.address.addressLocality,
    addressRegion: SITE.address.addressRegion,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.addressCountry,
  },
  areaServed: SITE.counties.map((county) => `${county} County, PA`),
  sameAs: [SITE.socials.facebook, SITE.socials.facebook_investigations],
};
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <Hero />
  <Services />
  <Trust />
  <Advantages />
  <Coverage />
  <QuoteForm />
</BaseLayout>
