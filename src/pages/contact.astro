---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactCta from '@/components/home/ContactCta.astro';
import { SITE } from '@/config/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact KRE Security',
    description: 'Request licensed security coverage or 24-hour dispatch from KRE Security in Hamburg, PA.',
    url: new URL('/contact/', SITE.url).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: SITE.name,
    description: SITE.description,
    url: SITE.url,
    telephone: SITE.phone.primary,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.streetAddress,
      addressLocality: SITE.address.addressLocality,
      addressRegion: SITE.address.addressRegion,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.addressCountry,
    },
  },
];
---

<BaseLayout
  title="Contact KRE Security | Hamburg, PA"
  description="Contact KRE Security for 24-hour dispatch, licensed guards, school security, ACT 67, and First Aid training across Eastern Pennsylvania."
  jsonLd={jsonLd}
>
  <div class="pt-8" data-ps="src/pages/contact.astro:lx8n1i">
    <ContactCta />
  </div>
</BaseLayout>
