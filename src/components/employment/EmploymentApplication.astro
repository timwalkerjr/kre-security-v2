---
import { SITE, designAsset } from '@/config/site';
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/employment/EmploymentApplication.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Apply Now</span>
        </div>
        <h2 class="text-[32px] sm:text-[36px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-5">
          KRE Employee Application
        </h2>
        <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-8">
          KRE Security has proudly served Eastern Pennsylvania since 1990 and continues to provide professional, first-class security services. Our team includes PA Act 235 certified officers, as well as retired and off-duty law enforcement officers.
        </p>
        <a
          href={SITE.adobeSignApplication}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-8 py-4 rounded-[10px] no-underline hover:bg-[#e0ab10] mb-8"
        >
          Start Online Application
        </a>
        <div class="border-t border-white/[0.09] pt-8">
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-4">Additional Submission Methods</p>
          <p class="text-[#a8a29e] text-[14px] leading-[22px] mb-4">Applications and resumes may also be submitted via:</p>
          <div class="space-y-3 text-[#a8a29e] text-[14px] leading-[22px]">
            <p class="m-0">
              <span class="text-[#f5bd14] font-bold">Email:</span>
              {' '}
              <a href={`mailto:${SITE.emails.employment}`} class="text-[#f5f5f4] no-underline hover:text-[#f5bd14]">{SITE.emails.employment}</a>
            </p>
            <p class="m-0"><span class="text-[#f5bd14] font-bold">Fax:</span> 484-660-3571</p>
            <p class="m-0">
              <span class="text-[#f5bd14] font-bold">In Person:</span> {SITE.address.streetAddress}, {SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}<br />
              <span class="text-[13px]">Monday to Friday, 9 AM – 6 PM. Just stop in.</span>
            </p>
            <p class="m-0">
              <span class="text-[#f5bd14] font-bold">Mail to:</span><br />
              KRE Security LLC.<br />
              Attn: Employment<br />
              {SITE.address.streetAddress}<br />
              {SITE.address.addressLocality}, {SITE.address.addressRegion} {SITE.address.postalCode}
            </p>
          </div>
        </div>
      </div>
      <div class="space-y-5">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
          <img src={designAsset('/images/lib/image-3-320.webp')} alt="KRE Security officer" class="w-full max-w-[320px] h-auto object-cover rounded-[12px]" loading="lazy" />
        </div>
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Hiring Office</p>
          <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Questions About Positions?</h3>
          <p class="text-[#a8a29e] text-[14px] leading-[22px] mb-3">
            Interested applicants may call us and a member of our hiring team will return your call.
          </p>
          <a href={`tel:${SITE.phone.primaryTel}`} class="text-[#f5f5f4] font-bold no-underline hover:text-[#f5bd14]">
            {SITE.phone.primary} Ext: 3
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
