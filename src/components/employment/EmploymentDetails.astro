---
const responsibilities = [
  'Access control and point-of-entry security',
  'Greeting and directing visitors',
  'CCTV and camera monitoring',
  'Routine security patrols to support site safety',
];

const qualifications = [
  "Stable work history",
  'Clean background',
  "Valid Pennsylvania Driver's License",
];

const benefits = [
  'Bi-weekly direct deposit',
  'Paid uniforms',
  'Paid training and holiday pay',
  'Veteran pay differential',
  '24/7 management and staffing support',
  'Family-owned company that values its employees',
];

const positions = [
  'Armed Act 235 Security Agent',
  'School Security Agent',
  'Seasonal Security Agent',
  'Retail Security Agent',
  'Weekend Commercial Security Agents',
];

const areas = [
  'Berks', 'Schuylkill', 'Lehigh', 'Carbon',
  'Lancaster', 'Lebanon', 'Montgomery', 'Pottsville',
];

const candidates = [
  'Retiree', 'Law Enforcement', 'Corrections',
  'Security', 'Public Safety', 'Veterans', 'College Students',
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/employment/EmploymentDetails.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="max-w-3xl mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Join Our Team</span>
      </div>
      <h2 class="text-[32px] sm:text-[40px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px] mb-6">
        Join the KRE Security Team
      </h2>
      <div class="space-y-4 text-[#a8a29e] text-[15px] leading-[24px]">
        <p class="m-0">
          KRE Security LLC offers a supplemental benefits package with partial employer contribution to employees who average 30 hours or more per week. We are proud to support the officers who represent our company and the clients we serve.
        </p>
        <p class="m-0">
          As our reputation continues to grow throughout Berks, Lancaster, Lehigh, and Schuylkill Counties and beyond, we are seeking professional security officers who demonstrate strong customer service skills, reliability, and sound security awareness.
        </p>
        <p class="m-0">
          We are currently hiring part-time security officers for weekday, evening, overnight, and weekend shifts. At KRE Security, you're not just another number. As a locally owned company, we take pride in building a team of professionals who support each other and provide exceptional service to our clients.
        </p>
        <p class="m-0">
          Officers may work at a consistent site or multiple client locations, depending on availability and preference. Whether you have prior security experience or are looking to start a new career, we're willing to train the right candidates.
        </p>
        <p class="text-[#f5f5f4] font-semibold m-0">
          Employees working 30+ hours per week who successfully complete our 60-day probationary period are eligible for Capital Blue Cross PPO health insurance with minimal employee contribution.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-16">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Responsibilities</p>
        <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Typical Responsibilities</h3>
        <ul class="space-y-2 m-0 p-0 list-none">
          {responsibilities.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Requirements</p>
        <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Basic Qualifications</h3>
        <ul class="space-y-2 mb-6 m-0 p-0 list-none">
          {qualifications.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Encouraged to Apply</p>
        <ul class="space-y-2 m-0 p-0 list-none">
          {candidates.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Compensation</p>
        <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Why Work With KRE Security?</h3>
        <ul class="space-y-2 m-0 p-0 list-none">
          {benefits.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Open Roles</p>
        <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Current Positions</h3>
        <ul class="space-y-2 m-0 p-0 list-none">
          {positions.map((p) => (
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-[#f5bd14] rounded-full shrink-0"></span>
              <span class="text-[#a8a29e] text-[14px]">{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Service Regions</p>
        <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-4">Areas of Employment</h3>
        <div class="grid grid-cols-2 gap-2">
          {areas.map((a) => (
            <span class="text-[#a8a29e] text-[14px] flex items-center gap-2">
              <span class="w-1.5 h-1.5 bg-[#f5bd14] rounded-full shrink-0"></span>
              {a}
            </span>
          ))}
        </div>
        <p class="text-[#a8a29e] text-[13px] italic mt-4 mb-0">And many more surrounding counties.</p>
      </div>
    </div>
  </div>
</section>
