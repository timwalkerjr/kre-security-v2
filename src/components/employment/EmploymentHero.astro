---
import { SITE } from '@/config/site';
---

<section class="relative isolate pt-[36px] pb-[56px]" data-ps="src/components/employment/EmploymentHero.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
      <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Now Hiring Across Eastern PA</span>
    </div>
    <p class="text-[#f5bd14] text-[13px] font-bold uppercase tracking-widest mb-4">{SITE.professionalLine}</p>
    <h1 class="text-[36px] sm:text-[48px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.2px] mb-5 max-w-3xl">
      Security Company Employment
    </h1>
    <p class="text-[#a8a29e] text-[17px] leading-[28px] mb-8 max-w-2xl">
      KRE Security LLC. is currently hiring for Full and Part Time Security agents and for Seasonal Security positions across Eastern Pennsylvania.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={SITE.adobeSignApplication}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-[24px] py-[13px] rounded-[10px] no-underline hover:bg-[#e0ab10]"
      >
        KRE Online Employment Application
      </a>
      <a
        href={`mailto:${SITE.emails.employment}`}
        class="border border-white/20 text-[#f5f5f4] font-semibold text-[14px] px-[24px] py-[13px] rounded-[10px] no-underline hover:border-[#f5bd14]"
      >
        Email Us
      </a>
    </div>
  </div>
</section>
