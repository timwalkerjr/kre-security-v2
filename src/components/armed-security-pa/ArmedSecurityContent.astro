---
import { designAsset } from '@/config/site';

const equipment = ['Firearm', 'Taser Gun', 'Expandable Baton', 'Flashlight', 'Handcuffs', 'O.C. Spray', 'Cell Phone'];
const deployments = [
  { title: 'Access Control', desc: 'Professional armed presence at entry points and secured facilities.' },
  { title: 'Personal Protection', desc: 'Dedicated armed officers for executive and personal protection assignments.' },
  { title: 'Plain Clothes Officers', desc: 'Inconspicuous armed security presence for sensitive or low-profile situations.' },
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/armed-security-pa/ArmedSecurityContent.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 mb-16 items-start">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Full Equipment Loadout</span>
        </div>
        <h2 class="text-[32px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-6">Our Armed Security Officers Carry:</h2>
        <div class="grid grid-cols-2 gap-3 mb-6">
          {equipment.map((item) => (
            <div class="flex items-center gap-3 bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-3">
              <span class="w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#f5f5f4] text-[14px] font-semibold">{item}</span>
            </div>
          ))}
        </div>
        <p class="text-[#a8a29e] text-[15px] leading-[24px] m-0">
          Our armed security officers are fully trained and certified in the use of all the equipment they carry. We offer plain clothes officers for an inconspicuous presence or black class A dress uniforms that give an authoritative visual appearance. Our armed security guard services can be employed for many uses from access control to personal protection.
        </p>
      </div>
      <div class="space-y-5">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-5 flex items-center justify-center">
          <img src={designAsset('/images/lib/pastedImage-249.webp')} alt="National Association of School Resource Officers" class="max-w-[249px] h-auto object-contain" loading="lazy" />
        </div>
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
          <img src={designAsset('/images/lib/39725c_5cd7e3e1e5d84cc6a46b497a37fc813c-mv2-320.webp')} alt="Armed security service companies PA" class="w-full max-w-[320px] mx-auto h-auto object-cover rounded-[12px]" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-8 lg:p-10 mb-10">
      <div class="mb-8">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-2">Deployment Options</p>
        <h2 class="text-[28px] font-extrabold text-[#f5f5f4]">Armed Security for Any Situation</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        {deployments.map((service) => (
          <div class="border border-white/[0.09] rounded-[12px] p-5">
            <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-2">Active</p>
            <h3 class="text-[16px] font-bold text-[#f5f5f4] mb-2">{service.title}</h3>
            <p class="text-[#a8a29e] text-[14px] leading-[22px] m-0">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="text-center">
      <a href="/contact/" class="inline-block bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-10 py-4 rounded-[10px] no-underline hover:bg-[#e0ab10]">Contact Us Today to Get Started</a>
    </div>
  </div>
</section>
