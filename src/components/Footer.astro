---
// Net Express Footer Component
---

<footer class="bg-[#06131f] text-[#9fb1c2] pt-[64px] pb-[28px]" data-ps="src/components/Footer.astro:footer">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/Footer.astro:container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12" data-ps="src/components/Footer.astro:grid">
      
      <!-- Col 1: Brand (5 cols) -->
      <div class="lg:col-span-5" data-ps="src/components/Footer.astro:brand">
        <a href="/#home" class="inline-block mb-4 no-underline" data-ps="src/components/Footer.astro:7gqbzq">
          <img
            src="https://pagesmith-cdn.com/726747c3/images/netexpress-logo-320.webp"
            alt="Net Express"
            width="169"
            height="31"
            class="h-[31px] w-[169px] object-contain"
            loading="lazy" data-ps="src/components/Footer.astro:4qdjex" />
        </a>
        <p class="text-[#9fb1c2] text-[14.72px] leading-[25px] max-w-[320px] m-0" data-ps="src/components/Footer.astro:tagline">
          Your single-source Michigan provider for business phone, data, internet, and IT. One provider, one bill, one support line.
        </p>
      </div>

      <!-- Col 2: Services (2 cols) -->
      <div class="lg:col-span-2" data-ps="src/components/Footer.astro:services">
        <h4 class="text-white text-[12.8px] font-bold uppercase tracking-[1.28px] mb-4" data-ps="src/components/Footer.astro:fy3jb4">
          Services
        </h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-[14.4px]">
          <li data-ps="src/components/Footer.astro:wyji5n"><a href="/#services" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqbzr">Hosted VoIP</a></li>
          <li data-ps="src/components/Footer.astro:wyji5o"><a href="/#services" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0d">Tailored Solutions</a></li>
          <li data-ps="src/components/Footer.astro:wyji5p"><a href="/#services" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0e">Internet & Fiber</a></li>
          <li data-ps="src/components/Footer.astro:wyji5q"><a href="/#services" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0f">Virtual Fax (FaxBridge)</a></li>
          <li data-ps="src/components/Footer.astro:wyji5r"><a href="/#services" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0g">Managed IT</a></li>
        </ul>
      </div>

      <!-- Col 3: Company (2 cols) -->
      <div class="lg:col-span-2" data-ps="src/components/Footer.astro:company">
        <h4 class="text-white text-[12.8px] font-bold uppercase tracking-[1.28px] mb-4" data-ps="src/components/Footer.astro:fy3jb3">
          Company
        </h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-[14.4px]">
          <li data-ps="src/components/Footer.astro:wyji5s"><a href="/#why" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0h">Why Net Express</a></li>
          <li data-ps="src/components/Footer.astro:wyji6e"><a href="/service-areas" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0i">Service Areas</a></li>
          <li data-ps="src/components/Footer.astro:footer-articles"><a href="/articles" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:footer-articles-link">Articles & Guides</a></li>
          <li data-ps="src/components/Footer.astro:wyji6f"><a href="/#reviews" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0j">Reviews</a></li>
          <li data-ps="src/components/Footer.astro:wyji6g"><a href="/#faq" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0k">FAQ</a></li>
          <li data-ps="src/components/Footer.astro:wyji6h"><a href="/#contact" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0l">Contact</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact (3 cols) -->
      <div class="lg:col-span-3" data-ps="src/components/Footer.astro:contact">
        <h4 class="text-white text-[12.8px] font-bold uppercase tracking-[1.28px] mb-4" data-ps="src/components/Footer.astro:fy3jb2">
          Contact
        </h4>
        <ul class="list-none p-0 m-0 space-y-2.5 text-[14.4px]">
          <li data-ps="src/components/Footer.astro:wyji6i"><a href="tel:+18553132300" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:7gqc0m">Toll free (855) 313-2300</a></li>
          <li data-ps="src/components/Footer.astro:wyji6j"><a href="tel:+12483132300" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:8o2pe">Local (248) 313-2300</a></li>
          <li class="pt-1 text-[#9fb1c2]" data-ps="src/components/Footer.astro:wyji6l">
            6825 Dixie Hwy<br />
            Clarkston, MI 48346
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/[0.09] pt-6 mt-12 flex flex-col sm:flex-row justify-between items-center gap-4 text-[13.6px] text-[#9fb1c2]" data-ps="src/components/Footer.astro:bottom-bar">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-1" data-ps="src/components/Footer.astro:p4vf8b">
        <p class="m-0" data-ps="src/components/Footer.astro:euoo">© 2026 Net Express. All rights reserved.</p>
        <span class="hidden sm:inline text-white/20" data-ps="src/components/Footer.astro:hzwfpb">|</span>
        <a href="/terms/" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:8o2pj">Terms of Service</a>
        <span class="text-white/20" data-ps="src/components/Footer.astro:hzwfpa">|</span>
        <a href="/privacy/" class="text-[#9fb1c2] hover:text-white transition-colors no-underline" data-ps="src/components/Footer.astro:8o2pk">Privacy Policy</a>
      </div>
      <p class="m-0 text-center sm:text-right" data-ps="src/components/Footer.astro:euop">Business phone · internet · IT · Michigan & the Midwest</p>
    </div>

    <!-- Agency Credit -->
    <div class="mt-4 text-center" data-ps="src/components/Footer.astro:credit">
      <a
        href="https://twalkerco.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#9fb1c2] text-[12px] hover:text-[#94e760] transition-colors no-underline inline-flex items-center gap-1.5"
       data-ps="src/components/Footer.astro:8o2pg">
        <img
          src="https://pagesmith-cdn.com/726747c3/images/twalkerco-w-webclip-256.webp"
          alt=""
          width="20"
          height="20"
          class="w-5 h-5 object-contain shrink-0"
          loading="lazy" data-ps="src/components/Footer.astro:4qdjex" />
        <span data-ps="src/components/Footer.astro:hzwfpf">Web Design and SEO by twalkerco</span>
      </a>
    </div>

  </div>
</footer>
