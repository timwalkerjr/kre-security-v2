---
import { SITE, designAsset } from '@/config/site';
---

<section id="first-aid-form" class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/first-aid-training/FirstAidForm.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Training Quote: Available</span>
        </div>
        <h2 class="text-[32px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-4">Request a Training Quote</h2>
        <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-8">
          Fill in your name, phone and email and we will contact you to discuss First Aid, CPR, and AED Training with you.
        </p>
        <form name="KRE Security — First Aid Training inquiry" method="POST" action="https://formspree.io/f/xdenabda" class="space-y-4">
          <input type="hidden" name="_subject" value="KRE Security — First Aid Training inquiry" />
          <input type="hidden" name="_next" value="/thanks/first-aid/" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="fa-first-name" class="block text-[11px] font-bold uppercase tracking-widest text-[#a8a29e] mb-1">First Name *</label>
              <input type="text" id="fa-first-name" name="first_name" required class="w-full bg-white/[0.04] border border-white/[0.12] rounded-[10px] px-4 py-3 text-[14px] text-[#f5f5f4] focus:outline-none focus:border-[#f5bd14]" />
            </div>
            <div>
              <label for="fa-last-name" class="block text-[11px] font-bold uppercase tracking-widest text-[#a8a29e] mb-1">Last Name</label>
              <input type="text" id="fa-last-name" name="last_name" class="w-full bg-white/[0.04] border border-white/[0.12] rounded-[10px] px-4 py-3 text-[14px] text-[#f5f5f4] focus:outline-none focus:border-[#f5bd14]" />
            </div>
          </div>
          <div>
            <label for="fa-phone" class="block text-[11px] font-bold uppercase tracking-widest text-[#a8a29e] mb-1">Phone Number</label>
            <input type="tel" id="fa-phone" name="phone" class="w-full bg-white/[0.04] border border-white/[0.12] rounded-[10px] px-4 py-3 text-[14px] text-[#f5f5f4] focus:outline-none focus:border-[#f5bd14]" />
          </div>
          <div>
            <label for="fa-email" class="block text-[11px] font-bold uppercase tracking-widest text-[#a8a29e] mb-1">Email Address *</label>
            <input type="email" id="fa-email" name="email" required class="w-full bg-white/[0.04] border border-white/[0.12] rounded-[10px] px-4 py-3 text-[14px] text-[#f5f5f4] focus:outline-none focus:border-[#f5bd14]" />
          </div>
          <div>
            <label for="fa-message" class="block text-[11px] font-bold uppercase tracking-widest text-[#a8a29e] mb-1">Message</label>
            <textarea id="fa-message" name="message" rows="4" class="w-full bg-white/[0.04] border border-white/[0.12] rounded-[10px] px-4 py-3 text-[14px] text-[#f5f5f4] focus:outline-none focus:border-[#f5bd14] resize-none"></textarea>
          </div>
          <button type="submit" class="w-full bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-8 py-4 rounded-[10px] hover:bg-[#e0ab10] border-0 cursor-pointer">
            Send Message
          </button>
        </form>
      </div>
      <div class="space-y-5">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
          <img src={designAsset('/images/lib/39725c_6425aae246544e0892331fb709c801fb-mv2-320.webp')} alt="Group CPR and First Aid training" class="w-full max-w-[320px] h-auto object-cover rounded-[12px]" loading="lazy" />
        </div>
        <p class="text-[#a8a29e] text-[14px] leading-[22px] m-0">
          Group CPR, First Aid, AED Training are conducted by our firm both in the field or in our educational teaching location.
        </p>
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-5">
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Contact Our Training Division</p>
          <div class="space-y-3">
            <div>
              <p class="text-[#a8a29e] text-[11px] uppercase tracking-widest mb-1 m-0">Reading / Eastern PA</p>
              <a href={`tel:${SITE.phone.primaryTel}`} class="text-[#f5f5f4] font-bold no-underline hover:text-[#f5bd14]">{SITE.phone.primary}</a>
            </div>
            <div>
              <p class="text-[#a8a29e] text-[11px] uppercase tracking-widest mb-1 m-0">Allentown / Bethlehem</p>
              <a href="tel:+14843343577" class="text-[#f5f5f4] font-bold no-underline hover:text-[#f5bd14]">484-334-3577</a>
            </div>
          </div>
        </div>
        <a href="/contact/" class="inline-block border border-white/20 text-[#f5f5f4] font-semibold text-[14px] px-6 py-3 rounded-[10px] no-underline hover:border-[#f5bd14]">
          Contact Us Today to Get Started
        </a>
      </div>
    </div>
  </div>
</section>
