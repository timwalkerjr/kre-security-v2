---
const benefits = [
  {
    num: '01',
    title: 'Sense of Security',
    desc: 'Even just the presence of a security guard can make a business more effective and efficient by giving the owners and employees peace of mind.',
  },
  {
    num: '02',
    title: 'Prevention',
    desc: 'A thief will think twice when there is a security guard present. It lets them know that you are serious about the security of your business and will deter them from targeting you.',
  },
  {
    num: '03',
    title: 'Customer Service',
    desc: 'Not only does a sense of security put your employees at ease but also your customers.',
  },
  {
    num: '04',
    title: 'Handling Crime',
    desc: 'Having a security guard will deter crime in your business but it may still happen; having security measures in place will allow police to solve a crime quickly and get you back to business in no time!',
  },
  {
    num: '05',
    title: 'Monitoring',
    desc: 'Take this responsibility off of your shoulders and leave your business security to a professional security guard company.',
  },
];
---

<section id="advantages" class="relative isolate py-[72px] lg:py-[92px]" data-ps="src/components/home/Advantages.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/Advantages.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-start" data-ps="src/components/home/Advantages.astro:grid">
      <div class="lg:col-span-6" data-ps="src/components/home/Advantages.astro:left-col">
        <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/Advantages.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#f5bd14]" data-ps="src/components/home/Advantages.astro:bar"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/Advantages.astro:label">
            Tactical advantage
          </span>
        </div>
        <h2 class="text-[36px] sm:text-[42px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px] mb-8" data-ps="src/components/home/Advantages.astro:h2">
          5 Benefits of Hiring a Security Company
        </h2>

        <div class="space-y-6" data-ps="src/components/home/Advantages.astro:list">
          {benefits.map((benefit) => (
            <div class="relative pl-8 border-l-2 border-[#f5bd14]/30 py-1" data-ps="src/components/home/Advantages.astro:item">
              <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-[#0a0a0a] border-2 border-[#f5bd14]" data-ps="src/components/home/Advantages.astro:dot"></span>
              <div class="text-[#f5bd14] text-[12.5px] font-bold tracking-[0.16em] mb-1" data-ps="src/components/home/Advantages.astro:num">
                {benefit.num}
              </div>
              <h3 class="text-[20px] font-bold text-[#f5f5f4] mb-2" data-ps="src/components/home/Advantages.astro:title">
                {benefit.title}
              </h3>
              <p class="text-[#a8a29e] text-[15px] leading-[24px] m-0 max-w-md" data-ps="src/components/home/Advantages.astro:desc">
                {benefit.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-6 lg:sticky lg:top-32" data-ps="src/components/home/Advantages.astro:right-col">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden" data-ps="src/components/home/Advantages.astro:photo-card">
          <div class="relative aspect-[4/5]" data-ps="src/components/home/Advantages.astro:photo-wrap">
            <img
              src="/images/field-ops.svg"
              alt="KRE Security field operations"
              class="w-full h-full object-cover opacity-85"
              width="640"
              height="800"
              data-ps="src/components/home/Advantages.astro:photo"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent" data-ps="src/components/home/Advantages.astro:fade"></div>
            <div class="absolute bottom-8 left-8 right-8" data-ps="src/components/home/Advantages.astro:caption">
              <div class="text-[#f5bd14] text-[11px] font-bold tracking-[0.2em] uppercase mb-1" data-ps="src/components/home/Advantages.astro:caption-kicker">
                Field Operations
              </div>
              <h3 class="text-[26px] font-extrabold text-white m-0" data-ps="src/components/home/Advantages.astro:caption-h">
                Protection Excellence
              </h3>
            </div>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-4" data-ps="src/components/home/Advantages.astro:stats">
          <div class="bg-white/[0.035] border border-white/[0.09] border-l-[#f5bd14] border-l-2 rounded-[16px] p-6" data-ps="src/components/home/Advantages.astro:stat-247">
            <div class="text-[36px] font-extrabold text-[#f5f5f4] leading-none" data-ps="src/components/home/Advantages.astro:stat-247-n">24/7</div>
            <div class="text-[11px] font-bold text-[#f5bd14] tracking-widest uppercase mt-2" data-ps="src/components/home/Advantages.astro:stat-247-l">Readiness</div>
          </div>
          <div class="bg-white/[0.035] border border-white/[0.09] border-l-[#f5bd14] border-l-2 rounded-[16px] p-6" data-ps="src/components/home/Advantages.astro:stat-100">
            <div class="text-[36px] font-extrabold text-[#f5f5f4] leading-none" data-ps="src/components/home/Advantages.astro:stat-100-n">100%</div>
            <div class="text-[11px] font-bold text-[#f5bd14] tracking-widest uppercase mt-2" data-ps="src/components/home/Advantages.astro:stat-100-l">Compliance</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
