---
// Trust highlights bar
---

<section id="trust-bar" class="relative isolate bg-[#0c2136]/50 border-y border-white/[0.06] py-[20px]" data-ps="src/components/home/TrustBar.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/TrustBar.astro:container">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[14.4px] text-[#b8c5d2] font-medium" data-ps="src/components/home/TrustBar.astro:items">
      
      <!-- Item 1: Google Reviews -->
      <div class="flex items-center gap-1.5" data-ps="src/components/home/TrustBar.astro:item-1">
        <span class="text-[#f59e0b] tracking-wider text-[15px]" data-ps="src/components/home/TrustBar.astro:c34k13">★★★★★</span>
        <span class="text-white font-bold" data-ps="src/components/home/TrustBar.astro:c34k14">5.0</span>
        <span data-ps="src/components/home/TrustBar.astro:c34k15">on Google Reviews</span>
      </div>

      <!-- Item 2: Single source -->
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:item-2">
        <span class="text-[#94e760] text-xs" data-ps="src/components/home/TrustBar.astro:c34k16">◆</span>
        <span data-ps="src/components/home/TrustBar.astro:c34k17"><strong class="text-white font-semibold">Single-source</strong> phone, data & internet</span>
      </div>

      <!-- Item 3: Service area -->
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:item-3">
        <span class="text-[#94e760] text-xs" data-ps="src/components/home/TrustBar.astro:c34k18">◆</span>
        <span data-ps="src/components/home/TrustBar.astro:c34k19">Serving <strong class="text-white font-semibold">Michigan & the Midwest</strong></span>
      </div>

      <!-- Item 4: No PBX hardware -->
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:item-4">
        <span class="text-[#94e760] text-xs" data-ps="src/components/home/TrustBar.astro:c34k1a">◆</span>
        <span data-ps="src/components/home/TrustBar.astro:c34k1b"><strong class="text-white font-semibold">No</strong> expensive PBX hardware</span>
      </div>

    </div>
  </div>
</section>
