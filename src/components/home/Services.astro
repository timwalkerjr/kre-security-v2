---
const services = [
  { title: 'Event Staffing', slug: 'school-event-staff' },
  { title: 'School Security', slug: 'school-security' },
  { title: 'Security Guards', slug: 'security-guards-pa' },
  { title: 'ACT 67 Certified Services', slug: 'act-67-certified-services' },
  { title: 'Private Investigations', slug: 'private-investigations' },
  { title: 'In-Home Security', slug: 'in-home-security' },
  { title: 'Security Checks', slug: 'security-checks' },
  { title: 'First Aid Training', slug: 'first-aid-training' },
  { title: 'Vehicle Patrol', slug: 'vehicle-patrol' },
  { title: 'Logistical Security', slug: 'logistical-security' },
  { title: 'Armed Security', slug: 'armed-security-pa' },
  { title: 'Warehouses & Distribution Centers', slug: 'warehouse-distribution-security' },
  { title: 'Event Traffic Control', slug: 'event-traffic-control' },
  { title: 'Process Services', slug: 'process-services' },
  { title: 'Fire Watch', slug: 'fire-watch' },
  { title: 'Armed Money Escorts', slug: 'armed-money-escorts' },
];
---

<section id="services" class="relative isolate py-[72px] lg:py-[92px]" data-ps="src/components/home/Services.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/Services.astro:container">
    <div class="max-w-[720px]" data-ps="src/components/home/Services.astro:header">
      <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/Services.astro:eyebrow">
        <span class="w-4 h-[2px] bg-[#f5bd14]" data-ps="src/components/home/Services.astro:4ny1y8"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/Services.astro:4ny1y7">
          Service portfolio
        </span>
      </div>
      <h2 class="text-[36px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px] mb-4" data-ps="src/components/home/Services.astro:h2">
        “Your Total Security Professional”
      </h2>
      <p class="text-[#a8a29e] text-[17.28px] leading-[28.51px]" data-ps="src/components/home/Services.astro:p">
        Comprehensive, professional, and responsive protection solutions tailored to your specific operational needs.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[20px] mt-[48px]" data-ps="src/components/home/Services.astro:grid">
      {services.map((service, index) => (
        <a
          href={`/${service.slug}/`}
          class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-[24px] hover:border-[#f5bd14]/40 hover:-translate-y-1 hover:shadow-[0_14px_40px_rgba(0,0,0,0.3)] transition-all no-underline flex flex-col justify-between min-h-[168px] group"
          data-ps={`src/components/home/Services.astro:card-${index + 1}`}
        >
          <div data-ps={`src/components/home/Services.astro:card-body-${index + 1}`}>
            <div class="text-[#f5bd14] text-[10.5px] font-bold tracking-[0.18em] uppercase mb-3" data-ps={`src/components/home/Services.astro:code-${index + 1}`}>
              CMD-SEC-0{index + 1}
            </div>
            <h3 class="text-[17px] font-bold text-[#f5f5f4] leading-snug" data-ps={`src/components/home/Services.astro:title-${index + 1}`}>
              {service.title}
            </h3>
          </div>
          <div class="mt-6 flex items-center gap-2 text-[12px] font-semibold text-[#a8a29e] group-hover:text-[#f5bd14] transition-colors uppercase tracking-wider" data-ps={`src/components/home/Services.astro:cta-${index + 1}`}>
            View protocol
            <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
