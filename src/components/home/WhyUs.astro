---
// Why Net Express Section
---

<section id="why" class="relative isolate bg-[#0c2136]/60 border-y border-white/[0.06] py-[92px]" data-ps="src/components/home/WhyUs.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/WhyUs.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-[56px] items-center" data-ps="src/components/home/WhyUs.astro:grid">
      
      <!-- Left Column: Copy -->
      <div data-ps="src/components/home/WhyUs.astro:left-col">
        <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/WhyUs.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#94e760]" data-ps="src/components/home/WhyUs.astro:au7lye"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/WhyUs.astro:au7lyf">
            Why Net Express
          </span>
        </div>
        
        <h2 class="text-[36px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4" data-ps="src/components/home/WhyUs.astro:h2">
          One provider instead of four.
        </h2>
        
        <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px] mb-6" data-ps="src/components/home/WhyUs.astro:p">
          Most businesses juggle separate vendors for phone, internet, fax, and IT — four bills, four support numbers, and finger-pointing when something breaks. We deliver all of it as a single, integrated service, backed by a local Michigan team that's accountable end to end.
        </p>

        <a
          href="/#contact"
          class="bg-white text-[#0a1a2e] font-semibold text-[15.2px] px-[24px] py-[13px] rounded-[10px] hover:bg-[#eef3f7] transition-all no-underline inline-block"
          data-ps="src/components/home/WhyUs.astro:cta"
        >
          Talk to a specialist
        </a>
      </div>

      <!-- Right Column: 6 Checklist Grid -->
      <div data-ps="src/components/home/WhyUs.astro:right-col">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-5 gap-x-6" data-ps="src/components/home/WhyUs.astro:checklist">
          
          <!-- Item 1 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-1">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpaz">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:au7lyg">One monthly bill</span>
          </div>

          <!-- Item 2 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-2">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpb0">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:au7lyh">One number for support</span>
          </div>

          <!-- Item 3 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-3">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpb1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:b3uloh">Keep your phone numbers</span>
          </div>

          <!-- Item 4 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-4">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpb2">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:b3ulog">No PBX hardware to buy</span>
          </div>

          <!-- Item 5 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-5">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpb3">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:b3ulof">Multi-location dialing</span>
          </div>

          <!-- Item 6 -->
          <div class="flex items-center" data-ps="src/components/home/WhyUs.astro:item-6">
            <div class="bg-[#94e760]/15 text-[#94e760] w-6 h-6 rounded-[6px] flex items-center justify-center mr-3 shrink-0" data-ps="src/components/home/WhyUs.astro:akxpb4">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-[#eef3f7] font-medium text-[15.68px]" data-ps="src/components/home/WhyUs.astro:b3uloe">Local, US-based team</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
