---
// Contact CTA & Formspree Form Section
---

<section id="contact" class="relative isolate bg-[#0c2136]/50 border-t border-white/[0.06] py-[80px] lg:py-[96px]" data-ps="src/components/home/ContactCta.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/ContactCta.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-start" data-ps="src/components/home/ContactCta.astro:grid">
      
      <!-- Left Column: Copy & Direct Contact Info -->
      <div class="lg:col-span-5 space-y-6" data-ps="src/components/home/ContactCta.astro:left-col">
        <div class="flex items-center gap-2 mb-2" data-ps="src/components/home/ContactCta.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#94e760]" data-ps="src/components/home/ContactCta.astro:tx0wsq"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/ContactCta.astro:tx0wsp">
            Get in touch
          </span>
        </div>
        
        <h2 class="text-[34px] sm:text-[42px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px]" data-ps="src/components/home/ContactCta.astro:h2">
          Let's simplify your business communications.
        </h2>
        
        <p class="text-[#9fb1c2] text-[16.5px] leading-[27px]" data-ps="src/components/home/ContactCta.astro:p">
          Connect with a Michigan-based specialist. Send us a message or request a custom quote for business phone, internet, or managed IT — we'll get back to you promptly.
        </p>

        <!-- Direct Contact Info Cards -->
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[18px] p-[24px] space-y-4" data-ps="src/components/home/ContactCta.astro:card">
          
          <!-- Call -->
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-1">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t6222x">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t6222y">
              <div class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t6222z">Call us directly</div>
              <div class="flex flex-wrap gap-x-3 gap-y-0.5" data-ps="src/components/home/ContactCta.astro:j6ox0h">
                <a href="tel:+18553132300" class="text-white font-bold text-[16px] hover:text-[#94e760] transition-colors no-underline block" data-ps="src/components/home/ContactCta.astro:tahw90">
                  (855) 313-2300
                </a>
                <span class="text-white/30" data-ps="src/components/home/ContactCta.astro:tx0wsv">•</span>
                <a href="tel:+12483132300" class="text-white font-bold text-[16px] hover:text-[#94e760] transition-colors no-underline block" data-ps="src/components/home/ContactCta.astro:local-phone">
                  (248) 313-2300
                </a>
              </div>
            </div>
          </div>

          <!-- Visit -->
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-3">
            <div class="bg-[#94e760]/12 text-[#94e760] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t62233">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62234">
              <div class="text-[#9fb1c2] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t62235">Office Location</div>
              <div class="text-white font-semibold text-[15.5px]" data-ps="src/components/home/ContactCta.astro:t62236">
                6825 Dixie Hwy, Clarkston, MI 48346
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Formspree Contact Form -->
      <div class="lg:col-span-7" data-ps="src/components/home/ContactCta.astro:right-col">
        <div class="bg-[#0b1f33]/90 border border-white/[0.1] rounded-[22px] p-6 sm:p-8 shadow-2xl backdrop-blur-md" data-ps="src/components/home/ContactCta.astro:form-box">
          
          <div class="mb-6" data-ps="src/components/home/ContactCta.astro:t6222x">
            <h3 class="text-white text-[22px] sm:text-[24px] font-bold mb-1" data-ps="src/components/home/ContactCta.astro:form-title">Send Us a Message</h3>
            <p class="text-[#9fb1c2] text-[14.5px] m-0" data-ps="src/components/home/ContactCta.astro:form-subtitle">Fill out the form below and our team will get back to you promptly.</p>
          </div>

          <form
            action="https://formspree.io/f/xqpkrgwd"
            method="POST"
            class="space-y-4"
            data-ps="src/components/home/ContactCta.astro:formspree-form"
          >
            <!-- Name & Email Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactCta.astro:t6222y">
              <div data-ps="src/components/home/ContactCta.astro:t6222z">
                <label for="form-name" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8s">
                  Your Name <span class="text-[#94e760]" data-ps="src/components/home/ContactCta.astro:tx0wsu">*</span>
                </label>
                <input
                  type="text"
                  id="form-name"
                  name="name"
                  required
                  placeholder="Jane Smith"
                  class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#9fb1c2]/50 text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors"
                />
              </div>

              <div data-ps="src/components/home/ContactCta.astro:t62230">
                <label for="form-email" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8r">
                  Your Email <span class="text-[#94e760]" data-ps="src/components/home/ContactCta.astro:tx0wst">*</span>
                </label>
                <input
                  type="email"
                  id="form-email"
                  name="email"
                  required
                  placeholder="jane@yourcompany.com"
                  class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#9fb1c2]/50 text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors"
                />
              </div>
            </div>

            <!-- Phone & Company Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactCta.astro:t62231">
              <div data-ps="src/components/home/ContactCta.astro:t62232">
                <label for="form-phone" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8q">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="form-phone"
                  name="phone"
                  placeholder="(248) 555-0123"
                  class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#9fb1c2]/50 text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors"
                />
              </div>

              <div data-ps="src/components/home/ContactCta.astro:t62233">
                <label for="form-company" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto84">
                  Company Name
                </label>
                <input
                  type="text"
                  id="form-company"
                  name="company"
                  placeholder="Acme Inc."
                  class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#9fb1c2]/50 text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors"
                />
              </div>
            </div>

            <!-- Service of Interest -->
            <div data-ps="src/components/home/ContactCta.astro:t62234">
              <label for="form-service" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto83">
                Service of Interest
              </label>
              <select
                id="form-service"
                name="service"
                class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors"
              >
                <option value="General Inquiry" class="bg-[#071626] text-white">General Inquiry / Not Sure Yet</option>
                <option value="Hosted VoIP Business Phone" class="bg-[#071626] text-white">Hosted VoIP Business Phone</option>
                <option value="Dedicated Fiber & High-Speed Internet" class="bg-[#071626] text-white">Dedicated Fiber & High-Speed Internet</option>
                <option value="5G Failover & Backup Connectivity" class="bg-[#071626] text-white">5G Failover & Backup Connectivity</option>
                <option value="Virtual Fax (FaxBridge)" class="bg-[#071626] text-white">Virtual Fax (FaxBridge)</option>
                <option value="Managed IT & Network Support" class="bg-[#071626] text-white">Managed IT & Network Support</option>
                <option value="Multi-Location Integration" class="bg-[#071626] text-white">Multi-Location Integration</option>
              </select>
            </div>

            <!-- Message -->
            <div data-ps="src/components/home/ContactCta.astro:t62235">
              <label for="form-message" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto82">
                Your Message <span class="text-[#94e760]" data-ps="src/components/home/ContactCta.astro:tx0wss">*</span>
              </label>
              <textarea
                id="form-message"
                name="message"
                required
                rows="4"
                placeholder="Tell us about your business locations, current phone/internet setup, or what you'd like to improve..."
                class="w-full bg-[#071626] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#9fb1c2]/50 text-[15px] focus:outline-none focus:border-[#94e760] focus:ring-1 focus:ring-[#94e760] transition-colors resize-y"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2" data-ps="src/components/home/ContactCta.astro:t62236">
              <button
                type="submit"
                class="w-full bg-white text-[#0a1a2e] font-bold text-[16px] px-6 py-4 rounded-[10px] hover:bg-[#eef3f7] hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2"
                data-ps="src/components/home/ContactCta.astro:submit-btn"
              >
                <span data-ps="src/components/home/ContactCta.astro:tx0wsr">Send Message</span>
                <svg class="w-5 h-5 text-[#0a1a2e]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>

            <p class="text-[#9fb1c2]/80 text-[12.5px] text-center pt-1 m-0" data-ps="src/components/home/ContactCta.astro:ymo90c">
              🔒 We respect your privacy. No spam, ever.
            </p>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>
