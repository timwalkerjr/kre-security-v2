---
// Contact CTA & Formspree Form Section
---

<section id="contact" class="relative isolate bg-black/50 border-t border-white/[0.06] py-[80px] lg:py-[96px]" data-ps="src/components/home/ContactCta.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/ContactCta.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-start" data-ps="src/components/home/ContactCta.astro:grid">
      <div class="lg:col-span-5 space-y-6" data-ps="src/components/home/ContactCta.astro:left-col">
        <div class="flex items-center gap-2 mb-2" data-ps="src/components/home/ContactCta.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#f5bd14]" data-ps="src/components/home/ContactCta.astro:tx0wsq"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/ContactCta.astro:tx0wsp">Get a quote</span>
        </div>
        <h2 class="text-[34px] sm:text-[42px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px]" data-ps="src/components/home/ContactCta.astro:h2">Licensed security for Pennsylvania.</h2>
        <p class="text-[#a8a29e] text-[16.5px] leading-[27px]" data-ps="src/components/home/ContactCta.astro:p">Call 24-hour dispatch or send a quote request. KRE Security covers 22+ counties from Hamburg, PA — guards, school security, ACT 67, and First Aid training.</p>
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[18px] p-[24px] space-y-4" data-ps="src/components/home/ContactCta.astro:card">
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-1">
            <div class="bg-[#f5bd14]/12 text-[#f5bd14] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t6222x">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t6222y">
              <div class="text-[#a8a29e] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t6222z">Call us directly</div>
              <a href="tel:+16105620971" class="text-white font-bold text-[16px] hover:text-[#f5bd14] transition-colors no-underline block" data-ps="src/components/home/ContactCta.astro:tahw90">610-562-0971</a>
            </div>
          </div>
          <div class="flex items-center gap-4" data-ps="src/components/home/ContactCta.astro:row-3">
            <div class="bg-[#f5bd14]/12 text-[#f5bd14] p-3 rounded-[10px] shrink-0" data-ps="src/components/home/ContactCta.astro:t62233">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62234">
              <div class="text-[#a8a29e] text-[11.5px] uppercase tracking-wider font-semibold" data-ps="src/components/home/ContactCta.astro:t62235">Office Location</div>
              <div class="text-white font-semibold text-[15.5px]" data-ps="src/components/home/ContactCta.astro:t62236">16600 Pottsville Pike, Hamburg, PA 19526</div>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7" data-ps="src/components/home/ContactCta.astro:right-col">
        <div class="bg-[#141414]/90 border border-white/[0.1] rounded-[22px] p-6 sm:p-8 shadow-2xl backdrop-blur-md" data-ps="src/components/home/ContactCta.astro:form-box">
          <div class="mb-6" data-ps="src/components/home/ContactCta.astro:t6222x">
            <h3 class="text-white text-[22px] sm:text-[24px] font-bold mb-1" data-ps="src/components/home/ContactCta.astro:form-title">Send Us a Message</h3>
            <p class="text-[#a8a29e] text-[14.5px] m-0" data-ps="src/components/home/ContactCta.astro:form-subtitle">Fill out the form below and our team will get back to you promptly.</p>
          </div>
          <form action="https://formspree.io/f/mljrgzln" method="POST" class="space-y-4" data-ps="src/components/home/ContactCta.astro:formspree-form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactCta.astro:t6222y">
              <div data-ps="src/components/home/ContactCta.astro:t6222z">
                <label for="form-name" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8s">Your Name <span class="text-[#f5bd14]" data-ps="src/components/home/ContactCta.astro:tx0wsu">*</span></label>
                <input type="text" id="form-name" name="name" required placeholder="Jane Smith" class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#a8a29e]/50 text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors" />
              </div>
              <div data-ps="src/components/home/ContactCta.astro:t62230">
                <label for="form-email" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8r">Your Email <span class="text-[#f5bd14]" data-ps="src/components/home/ContactCta.astro:tx0wst">*</span></label>
                <input type="email" id="form-email" name="email" required placeholder="jane@yourcompany.com" class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#a8a29e]/50 text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-ps="src/components/home/ContactCta.astro:t62231">
              <div data-ps="src/components/home/ContactCta.astro:t62232">
                <label for="form-phone" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto8q">Phone Number</label>
                <input type="tel" id="form-phone" name="phone" placeholder="610-562-0971" class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#a8a29e]/50 text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors" />
              </div>
              <div data-ps="src/components/home/ContactCta.astro:t62233">
                <label for="form-company" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto84">Company Name</label>
                <input type="text" id="form-company" name="company" placeholder="Acme Inc." class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#a8a29e]/50 text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors" />
              </div>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62234">
              <label for="form-service" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto83">Service of Interest</label>
              <select id="form-service" name="service" class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors">
                <option value="General Inquiry" class="bg-[#141414] text-white">General Inquiry</option>
                <option value="Security Guards" class="bg-[#141414] text-white">Security Guards</option>
                <option value="School Security" class="bg-[#141414] text-white">School Security</option>
                <option value="ACT 67 Training" class="bg-[#141414] text-white">ACT 67 Training</option>
                <option value="First Aid Training" class="bg-[#141414] text-white">First Aid Training</option>
                <option value="Employment" class="bg-[#141414] text-white">Employment</option>
              </select>
            </div>
            <div data-ps="src/components/home/ContactCta.astro:t62235">
              <label for="form-message" class="block text-white text-[13.5px] font-medium mb-1.5" data-ps="src/components/home/ContactCta.astro:knto82">Your Message <span class="text-[#f5bd14]" data-ps="src/components/home/ContactCta.astro:tx0wss">*</span></label>
              <textarea id="form-message" name="message" required rows="4" placeholder="Tell us about the site, hours, and the coverage you need..." class="w-full bg-[#0a0a0a] border border-white/[0.12] rounded-[10px] px-4 py-3 text-white placeholder-[#a8a29e]/50 text-[15px] focus:outline-none focus:border-[#f5bd14] focus:ring-1 focus:ring-[#f5bd14] transition-colors resize-y"></textarea>
            </div>
            <div class="pt-2" data-ps="src/components/home/ContactCta.astro:t62236">
              <button type="submit" class="w-full bg-white text-[#0a0a0a] font-bold text-[16px] px-6 py-4 rounded-[10px] hover:bg-[#e7e5e4] hover:shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2" data-ps="src/components/home/ContactCta.astro:submit-btn">
                <span data-ps="src/components/home/ContactCta.astro:tx0wsr">Send Message</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
