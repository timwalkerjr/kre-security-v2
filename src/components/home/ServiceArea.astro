---
// Service Area Section
---

<section id="areas" class="relative isolate py-[92px]" data-ps="src/components/home/ServiceArea.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/ServiceArea.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-center" data-ps="src/components/home/ServiceArea.astro:grid">
      
      <!-- Left Column: Copy & City Tags -->
      <div class="lg:col-span-7" data-ps="src/components/home/ServiceArea.astro:left-col">
        <div class="flex items-center gap-2 mb-3" data-ps="src/components/home/ServiceArea.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#94e760]" data-ps="src/components/home/ServiceArea.astro:f4pfsy"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/ServiceArea.astro:f4pfsz">
            Service area
          </span>
        </div>
        
        <h2 class="text-[36px] sm:text-[44px] font-extrabold text-[#eef3f7] leading-[1.08] tracking-[-1.1px] mb-4" data-ps="src/components/home/ServiceArea.astro:h2">
          Serving Michigan, the Midwest & Reading, PA.
        </h2>
        
        <p class="text-[#9fb1c2] text-[17.28px] leading-[28.51px] mb-6" data-ps="src/components/home/ServiceArea.astro:p">
          Headquartered in Clarkston, we support businesses from single storefronts to multi-location enterprises across the region — with the responsiveness of a local partner and the reach of a full-service carrier.
        </p>

        <!-- City Pill Badges -->
        <div class="flex flex-wrap gap-2.5 mt-6 mb-6" data-ps="src/components/home/ServiceArea.astro:pills">
          <a href="/service-areas/clarkston" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:f4pft0">Clarkston</a>
          <a href="/service-areas/metro-detroit" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:f4pft1">Metro Detroit</a>
          <a href="/service-areas/oakland-county" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:fjuae5">Oakland County</a>
          <a href="/service-areas" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:fjuae4">Flint</a>
          <a href="/service-areas/grand-rapids" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:fjuae3">Grand Rapids</a>
          <a href="/service-areas" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:fjuae2">Lansing</a>
          <a href="/service-areas" class="bg-white/[0.035] hover:bg-white/[0.08] hover:border-[#94e760]/40 border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:fjuae1">Ann Arbor</a>
          <a href="/service-areas/reading/" class="bg-white/[0.035] hover:bg-white/[0.08] border border-white/[0.09] text-[#b8c5d2] hover:text-white text-[14.4px] px-[16px] py-[6px] rounded-full transition-colors no-underline" data-ps="src/components/home/ServiceArea.astro:dvh6g4">Reading, PA</a>
          <span class="bg-white/[0.035] border border-white/[0.09] text-[#b8c5d2] text-[14.4px] px-[16px] py-[6px] rounded-full" data-ps="src/components/home/ServiceArea.astro:fjuae0">& the Midwest</span>
        </div>

        <div data-ps="src/components/home/ServiceArea.astro:r9lri4">
          <a href="/service-areas" class="text-[#94e760] font-semibold text-[15px] hover:underline no-underline inline-flex items-center gap-1.5" data-ps="src/components/home/ServiceArea.astro:dvh6g3">
            Explore All Service Areas & Coverage &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column: HQ & Speed Box -->
      <div class="lg:col-span-5" data-ps="src/components/home/ServiceArea.astro:right-col">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[18px] p-[36px] text-center" data-ps="src/components/home/ServiceArea.astro:card">
          <div class="text-[#94e760] font-extrabold text-[48px] leading-none mb-2" data-ps="src/components/home/ServiceArea.astro:stat">
            5 Gbps
          </div>
          <p class="text-[#b8c5d2] text-[15px] mb-6" data-ps="src/components/home/ServiceArea.astro:stat-label">
            dedicated fiber speeds available
          </p>

          <div class="w-full h-[1px] bg-white/[0.09] my-6" data-ps="src/components/home/ServiceArea.astro:r9lri4"></div>

          <div class="space-y-1" data-ps="src/components/home/ServiceArea.astro:location">
            <h3 class="text-white font-bold text-[16px] mb-1" data-ps="src/components/home/ServiceArea.astro:gp4q17">Net Express HQ</h3>
            <p class="text-[#9fb1c2] text-[14px] m-0" data-ps="src/components/home/ServiceArea.astro:dn7yf7">6825 Dixie Hwy</p>
            <p class="text-[#9fb1c2] text-[14px] m-0" data-ps="src/components/home/ServiceArea.astro:dn7yf8">Clarkston, MI 48346</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
