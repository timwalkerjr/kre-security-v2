---
// Testimonial / Review Section
---

<section id="reviews" class="relative isolate py-[72px]" data-ps="src/components/home/Testimonial.astro:section">
  <div class="max-w-[860px] mx-auto px-6 text-center" data-ps="src/components/home/Testimonial.astro:container">
    
    <!-- Stars -->
    <div class="text-[#f59e0b] text-[22px] tracking-widest mb-6 flex justify-center gap-1" aria-label="5 out of 5 stars" data-ps="src/components/home/Testimonial.astro:stars">
      ★★★★★
    </div>

    <!-- Quote -->
    <blockquote class="text-[24px] sm:text-[28px] md:text-[30px] font-bold text-white leading-snug mb-6 italic" data-ps="src/components/home/Testimonial.astro:quote">
      "When we started looking at VoIP options, most providers wanted us to rip out our Avaya PBX and start from scratch. Net Express met us where we were and made the switch painless."
    </blockquote>

    <!-- Attribution -->
    <p class="text-[#9fb1c2] text-[16px] font-normal" data-ps="src/components/home/Testimonial.astro:author">
      <strong class="text-[#eef3f7] font-semibold">Michael Torres</strong> · 5.0 on Google Reviews
    </p>

  </div>
</section>
