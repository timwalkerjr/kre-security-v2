---
// Net Express Hero Section
---

<section id="home" class="relative isolate pt-[64px] pb-[48px] overflow-hidden" data-ps="src/components/home/Hero.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/Hero.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-center" data-ps="src/components/home/Hero.astro:grid">
      
      <!-- Left Column: Copy & CTA -->
      <div class="lg:col-span-7 flex flex-col items-start text-left" data-ps="src/components/home/Hero.astro:left-col">
        <!-- Eyebrow -->
        <div class="flex items-center gap-2 mb-4" data-ps="src/components/home/Hero.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#94e760]" data-ps="src/components/home/Hero.astro:z1i1xh"></span>
          <span class="text-[#94e760] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/Hero.astro:z1i1xg">
            VoIP · Business Internet · Managed IT
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-[50px] sm:text-[62.4px] font-extrabold text-[#eef3f7] leading-[1.02] tracking-[-2.18px] mb-6" data-ps="src/components/home/Hero.astro:h1">
          Always on.<br />
          <span class="text-[#94e760]" data-ps="src/components/home/Hero.astro:z1i1xf">Always local.</span>
        </h1>

        <!-- Subhead -->
        <p class="text-[#9fb1c2] text-[18.56px] leading-[29.7px] font-normal mb-8 max-w-[540px]" data-ps="src/components/home/Hero.astro:p">
          Business phone, internet, and IT from one Michigan provider — engineered so you never miss a call, a customer, or a beat.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 mb-8" data-ps="src/components/home/Hero.astro:actions">
          <a
            href="/#contact"
            class="bg-white text-[#0a1a2e] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:bg-[#eef3f7] hover:shadow-lg transition-all no-underline inline-flex items-center gap-1.5"
            data-ps="src/components/home/Hero.astro:cta-primary"
          >
            Get a Free Quote →
          </a>
          <a
            href="/#services"
            class="border border-white/20 text-[#e6ecf2] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:border-[#94e760] hover:text-white transition-all no-underline"
            data-ps="src/components/home/Hero.astro:cta-secondary"
          >
            See What We Do
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="flex flex-wrap items-center gap-6 text-[#b8c5d2] text-[13.6px]" data-ps="src/components/home/Hero.astro:trust">
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4taf">
            <span class="w-2 h-2 rounded-full bg-[#94e760]" data-ps="src/components/home/Hero.astro:z1i1xe"></span>
            <span data-ps="src/components/home/Hero.astro:z1i1xd">Locally owned & operated</span>
          </div>
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4tag">
            <span class="w-2 h-2 rounded-full bg-[#94e760]" data-ps="src/components/home/Hero.astro:z1i1xc"></span>
            <span data-ps="src/components/home/Hero.astro:z1i1xb">One provider, one bill</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Client Support Center Card -->
      <div class="lg:col-span-5" data-ps="src/components/home/Hero.astro:right-col">
        <div class="bg-[#0c2136]/90 backdrop-blur-md border border-[#94e760]/25 rounded-[20px] p-[24px] shadow-2xl" data-ps="src/components/home/Hero.astro:support-panel">
          
          <!-- Panel Header -->
          <div class="text-center mb-5" data-ps="src/components/home/Hero.astro:panel-head">
            <h2 class="text-white font-bold text-[18px] mb-1" data-ps="src/components/home/Hero.astro:bo7d5u">Client Support Center</h2>
            <div class="flex items-center justify-center gap-1.5 text-[#9fb1c2] text-[12.48px]" data-ps="src/components/home/Hero.astro:iy4tah">
              <span class="w-2 h-2 rounded-full bg-[#94e760] animate-pulse" data-ps="src/components/home/Hero.astro:z1i1xa"></span>
              <span data-ps="src/components/home/Hero.astro:z1i1wo">Online · 24/7 US-based support</span>
            </div>
          </div>

          <!-- Interactive Action Rows -->
          <div class="space-y-2.5" data-ps="src/components/home/Hero.astro:support-links">
            <!-- Row 1: Remote Support -->
            <a
              href="https://remote.aperion.com/as/wapi/goto_downloader?role=attendee"
              class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#94e760]/[0.08] hover:border-[#94e760]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline"
             data-ps="src/components/home/Hero.astro:8zc15">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf3">
                <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgf4">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="text-white font-medium text-[15px] group-hover:text-white" data-ps="src/components/home/Hero.astro:z1i1wn">Remote Support</span>
              </div>
              <svg class="w-4 h-4 text-[#9fb1c2] group-hover:text-[#94e760] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Row 2: Open a Support Ticket -->
            <a
              href="https://portal.gonetexpress.com/"
              class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#94e760]/[0.08] hover:border-[#94e760]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline"
             data-ps="src/components/home/Hero.astro:8zc16">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf5">
                <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgf6">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                  </svg>
                </div>
                <span class="text-white font-medium text-[15px] group-hover:text-white" data-ps="src/components/home/Hero.astro:z1i1wm">Open a Support Ticket</span>
              </div>
              <svg class="w-4 h-4 text-[#9fb1c2] group-hover:text-[#94e760] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Row 3: Pay Your Invoice -->
            <a
              href="https://invoice.gonetexpress.com/"
              class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#94e760]/[0.08] hover:border-[#94e760]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline"
             data-ps="src/components/home/Hero.astro:8zc17">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf7">
                <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgf8">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <span class="text-white font-medium text-[15px] group-hover:text-white" data-ps="src/components/home/Hero.astro:z1i1wl">Pay Your Invoice</span>
              </div>
              <svg class="w-4 h-4 text-[#9fb1c2] group-hover:text-[#94e760] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Row 4: Client Portal -->
            <a
              href="https://portal.gonetexpress.com/"
              class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#94e760]/[0.08] hover:border-[#94e760]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline"
             data-ps="src/components/home/Hero.astro:8zc1t">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgf9">
                <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgfa">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <span class="text-white font-medium text-[15px] group-hover:text-white" data-ps="src/components/home/Hero.astro:z1i1wk">Client Portal</span>
              </div>
              <svg class="w-4 h-4 text-[#9fb1c2] group-hover:text-[#94e760] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>

            <!-- Row 5: Call Support -->
            <a
              href="tel:+18553132300"
              class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#94e760]/[0.08] hover:border-[#94e760]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline"
             data-ps="src/components/home/Hero.astro:8zc1u">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgfb">
                <div class="bg-[#94e760]/15 text-[#94e760] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgfc">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <span class="text-white font-medium text-[15px] group-hover:text-white" data-ps="src/components/home/Hero.astro:z1i1wj">Call Support</span>
              </div>
              <svg class="w-4 h-4 text-[#9fb1c2] group-hover:text-[#94e760] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
