---
import { SITE } from '@/config/site';
const actionRows = [
  { label: `Call ${SITE.phone.primary}`, href: `tel:${SITE.phone.primaryTel}`, icon: 'phone' },
  { label: 'Facebook', href: SITE.socials.facebook, external: true, icon: 'facebook' },
  { label: 'KRE Employment Application', href: '/employee-application/', icon: 'clipboard' },
  { label: 'KRE Job Openings', href: '/employment/', icon: 'briefcase' },
  { label: 'ACT 67 Training', href: '/act-67-certified-services/', icon: 'grad' },
  { label: 'First Aid Training Services', href: '/first-aid-training/', icon: 'heart' },
] as const;
const icons: Record<string, string> = {
  phone: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />',
  facebook: '<path fill="currentColor" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>',
  clipboard: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />',
  briefcase: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  grad: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />',
  school: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0v7m-4-3h8" />',
};
---
<section id="home" class="relative isolate pt-[36px] pb-[48px] overflow-hidden" data-ps="src/components/home/Hero.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/home/Hero.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[48px] items-start lg:items-center" data-ps="src/components/home/Hero.astro:grid">
      <div class="lg:col-span-7 flex flex-col items-start text-left" data-ps="src/components/home/Hero.astro:left-col">
        <div class="flex items-center gap-2 mb-4" data-ps="src/components/home/Hero.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#f5bd14]" data-ps="src/components/home/Hero.astro:z1i1xh"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/home/Hero.astro:z1i1xg">Now Hiring</span>
        </div>
        <h1 class="text-[42px] sm:text-[62.4px] font-extrabold text-[#f5f5f4] leading-[1.02] tracking-[-2.18px] mb-5" data-ps="src/components/home/Hero.astro:h1">Precision protection<br /><span class="text-[#f5bd14]" data-ps="src/components/home/Hero.astro:z1i1xf">for the Commonwealth.</span></h1>
        <p class="text-[#a8a29e] text-[18.56px] leading-[29.7px] font-normal mb-3 max-w-[560px]" data-ps="src/components/home/Hero.astro:p">{SITE.tagline}</p>
        <p class="text-[#d6d3d1] text-[15.5px] leading-[24px] mb-6 max-w-[560px]" data-ps="src/components/home/Hero.astro:ownership">{SITE.professionalLine}. {SITE.ownershipLine}. {SITE.veteranLine}. {SITE.license}.</p>
        <div class="flex flex-wrap gap-4 mb-8" data-ps="src/components/home/Hero.astro:actions">
          <a href={`tel:${SITE.phone.primaryTel}`} class="bg-white text-[#0a0a0a] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:bg-[#e7e5e4] hover:shadow-lg transition-all no-underline inline-flex items-center gap-1.5" data-ps="src/components/home/Hero.astro:cta-primary">24hr dispatch {SITE.phone.primary}</a>
          <a href="/employment/" class="border border-white/20 text-[#f5f5f4] font-semibold text-[16px] px-[28px] py-[15px] rounded-[10px] hover:border-[#f5bd14] hover:text-white transition-all no-underline" data-ps="src/components/home/Hero.astro:cta-secondary">Join our team</a>
        </div>
        <div class="flex flex-wrap items-center gap-6 text-[#d6d3d1] text-[13.6px]" data-ps="src/components/home/Hero.astro:trust">
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4taf"><span class="w-2 h-2 rounded-full bg-[#f5bd14]" data-ps="src/components/home/Hero.astro:z1i1xe"></span><span data-ps="src/components/home/Hero.astro:z1i1xd">{SITE.veteranLine}</span></div>
          <div class="flex items-center gap-2" data-ps="src/components/home/Hero.astro:iy4tag"><span class="w-2 h-2 rounded-full bg-[#f5bd14]" data-ps="src/components/home/Hero.astro:z1i1xc"></span><span data-ps="src/components/home/Hero.astro:z1i1xb">{SITE.license} · Since 2016</span></div>
        </div>
      </div>
      <div class="lg:col-span-5" data-ps="src/components/home/Hero.astro:right-col">
        <div class="bg-[#141414]/90 backdrop-blur-md border border-[#f5bd14]/25 rounded-[20px] p-[24px] shadow-2xl" data-ps="src/components/home/Hero.astro:support-panel">
          <div class="text-center mb-5" data-ps="src/components/home/Hero.astro:panel-head">
            <h2 class="text-white font-bold text-[18px] mb-1" data-ps="src/components/home/Hero.astro:bo7d5u">Hire · Train · Dispatch</h2>
            <div class="flex items-center justify-center gap-1.5 text-[#a8a29e] text-[12.48px]" data-ps="src/components/home/Hero.astro:iy4tah">
              <span class="w-2 h-2 rounded-full bg-[#f5bd14] animate-pulse" data-ps="src/components/home/Hero.astro:z1i1xa"></span>
              <span data-ps="src/components/home/Hero.astro:z1i1wo">Online · 24-hour emergency dispatch</span>
            </div>
          </div>
          <div class="space-y-2.5" data-ps="src/components/home/Hero.astro:support-links">
            {actionRows.map((row, index) => (
              <a href={row.href} target={'external' in row && row.external ? '_blank' : undefined} rel={'external' in row && row.external ? 'noopener noreferrer' : undefined} class="bg-white/[0.035] border border-white/[0.09] hover:bg-[#f5bd14]/[0.08] hover:border-[#f5bd14]/50 rounded-[12px] p-[14px_16px] flex items-center justify-between transition-all group no-underline" data-ps={`src/components/home/Hero.astro:8zc1${index}`}>
                <div class="flex items-center gap-3" data-ps={`src/components/home/Hero.astro:ecxgf${index}`}>
                  <div class="bg-[#f5bd14]/15 text-[#f5bd14] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps={`src/components/home/Hero.astro:icon-${index}`}>
                    <svg class="w-5 h-5" fill={row.icon === 'facebook' ? 'currentColor' : 'none'} stroke="currentColor" viewBox="0 0 24 24" set:html={icons[row.icon]} />
                  </div>
                  <span class="text-white font-medium text-[15px]" data-ps={`src/components/home/Hero.astro:label-${index}`}>{row.label}</span>
                </div>
                <svg class="w-4 h-4 text-[#a8a29e] group-hover:text-[#f5bd14] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
            ))}
            <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] p-[14px_16px] flex items-center justify-between" role="group" aria-label="Eastern PA Educators" data-ps="src/components/home/Hero.astro:8zc1u">
              <div class="flex items-center gap-3" data-ps="src/components/home/Hero.astro:ecxgfb">
                <div class="bg-[#f5bd14]/15 text-[#f5bd14] w-9 h-9 rounded-[9px] flex items-center justify-center shrink-0" data-ps="src/components/home/Hero.astro:ecxgfc">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icons.school} />
                </div>
                <span class="text-white font-medium text-[15px]" data-ps="src/components/home/Hero.astro:z1i1wj">Eastern PA Educators</span>
              </div>
            </div>
            <div class="pt-2 mt-1 border-t border-white/[0.08] space-y-1.5" data-ps="src/components/home/Hero.astro:regional-phones">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#f5bd14] m-0" data-ps="src/components/home/Hero.astro:regional-label">Regional offices</p>
              {SITE.offices.map((office) => (
                <a href={`tel:${office.tel}`} class="flex items-start justify-between gap-3 text-[12.5px] text-[#d6d3d1] hover:text-white no-underline" data-ps="src/components/home/Hero.astro:regional-row">
                  <span data-ps="src/components/home/Hero.astro:regional-name">{office.label}</span>
                  <span class="font-semibold text-white whitespace-nowrap" data-ps="src/components/home/Hero.astro:regional-phone">{office.phone}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
