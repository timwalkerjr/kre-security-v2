---
import { SITE } from '@/config/site';

const serviceAreas = [
  { name: 'Quakertown', url: '/armed-security-guards-quakertown-pa/' },
  { name: 'Coopersburg', url: '/armed-security-pa/' },
  { name: 'Center Valley', url: '/security-guards-pa/' },
  { name: 'Perkasie', url: '/armed-security-pa/' },
  { name: 'Sellersville', url: '/security-guards-pa/' },
  { name: 'Trumbaursville', url: '/armed-security-pa/' },
  { name: 'Spinnersville', url: '/security-guards-pa/' },
  { name: 'Zionhill', url: '/armed-security-pa/' },
  { name: 'Limeport', url: '/security-guards-pa/' },
  { name: 'East Greenville', url: '/armed-security-pa/' },
];

const hours = [
  { day: 'Monday', hours: 'Open 24 Hours' },
  { day: 'Tuesday', hours: 'Open 24 Hours' },
  { day: 'Wednesday', hours: 'Open 24 Hours' },
  { day: 'Thursday', hours: 'Open 24 Hours' },
  { day: 'Friday', hours: 'Open 24 Hours' },
  { day: 'Saturday', hours: 'Closed' },
  { day: 'Sunday', hours: 'Closed' },
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/armed-security-guards-quakertown-pa/QuakertownContent.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 mb-16">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Verified Reviews</span>
        </div>
        <h2 class="text-[32px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-6">Our Quakertown Armed Security Guard Reviews</h2>
        <div class="space-y-4">
          <a
            href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-5 no-underline hover:border-[#f5bd14] transition-colors"
          >
            <span class="text-[#f5bd14] text-[24px] font-extrabold">G</span>
            <div>
              <p class="text-[#f5f5f4] text-[14px] font-bold m-0">Google Maps Reviews</p>
              <p class="text-[#a8a29e] text-[12px] m-0">View our armed security guard reviews on Google</p>
            </div>
            <span class="ml-auto text-[#a8a29e]">→</span>
          </a>
          <a
            href="https://www.bark.com/en/company/kre-security-investigations/9enON/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-5 no-underline hover:border-[#f5bd14] transition-colors"
          >
            <span class="text-[#f5bd14] text-[24px] font-extrabold">B</span>
            <div>
              <p class="text-[#f5f5f4] text-[14px] font-bold m-0">Bark.com Reviews</p>
              <p class="text-[#a8a29e] text-[12px] m-0">View our armed security guard reviews on Bark.com</p>
            </div>
            <span class="ml-auto text-[#a8a29e]">→</span>
          </a>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Coverage Zone</span>
        </div>
        <h2 class="text-[32px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-6">Proudly Serving</h2>
        <div class="grid grid-cols-2 gap-2 mb-6">
          {serviceAreas.map((area) => (
            <a href={area.url} class="flex items-center gap-2 text-[#a8a29e] hover:text-[#f5bd14] text-[14px] no-underline py-1">
              <span class="w-1.5 h-1.5 bg-[#f5bd14] shrink-0 rounded-full"></span>
              {area.name}
            </a>
          ))}
        </div>
        <p class="text-[#a8a29e] text-[14px] m-0">
          And surrounding cities —{' '}
          <a href="/" class="text-[#f5bd14] hover:underline">View All Service Areas</a>
        </p>
      </div>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-8 lg:p-10">
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Main Office</p>
          <h3 class="text-[20px] font-extrabold text-[#f5f5f4] mb-4">KRE Security</h3>
          <div class="space-y-1 text-[#a8a29e] text-[14px] mb-6">
            <p class="m-0">11 S 3rd St</p>
            <p class="m-0">Hamburg, PA 19526</p>
            <a href={`tel:${SITE.phone.primaryTel}`} class="block text-[#f5bd14] font-bold text-[18px] no-underline hover:underline mt-2">
              {SITE.phone.primary}
            </a>
          </div>
          <a
            href="https://www.google.com/maps/place/KRE+Security+LLC/@40.5573641,-75.9865777,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block border border-white/20 text-[#f5f5f4] font-semibold text-[13px] px-5 py-3 rounded-[10px] no-underline hover:border-[#f5bd14]"
          >
            Get Driving Directions
          </a>
        </div>
        <div>
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-4">Hours of Operation</p>
          <div class="space-y-2">
            {hours.map(({ day, hours: hoursLabel }) => (
              <div class="flex justify-between items-center border-b border-white/[0.09] pb-2">
                <span class="text-[#a8a29e] text-[14px]">{day}</span>
                <span class:list={['text-[12px] font-bold uppercase tracking-wide', hoursLabel === 'Open 24 Hours' ? 'text-[#f5bd14]' : 'text-[#a8a29e]']}>
                  {hoursLabel}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
