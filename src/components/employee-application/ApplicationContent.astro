---
import { SITE } from '@/config/site';
---

<section class="relative isolate pt-[36px] pb-[96px]" data-ps="src/components/employee-application/ApplicationContent.astro:section">
  <div class="max-w-[720px] mx-auto px-6">
    <div class="text-center mb-12">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Now Hiring</span>
      </div>
      <h1 class="text-[36px] sm:text-[48px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.2px]">
        Employee Hiring Application
      </h1>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7 mb-10">
      <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">KRE Disclaimer</p>
      <p class="text-[#f5f5f4] text-[15px] leading-[24px] m-0">
        KRE Security, working under the laws of the Commonwealth of Pennsylvania will not employ any individual convicted of a Felony. A conviction is an immediate disqualification of an employment opportunity in the capacity of a Security Guard in the Commonwealth.
      </p>
    </div>

    <div class="text-center mb-16">
      <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-6">
        Click below to begin your online employment application through our secure Adobe Sign portal.
      </p>
      <a
        href={SITE.adobeSignApplication}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-10 py-5 rounded-[10px] no-underline hover:bg-[#e0ab10]"
      >
        Click Here to Start Application
      </a>
      <p class="text-[#a8a29e] text-[12px] mt-4 mb-0">Opens in a new window via Adobe Sign</p>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7 text-center">
      <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-2">Questions? Contact Us</p>
      <p class="text-[#a8a29e] text-[14px] mb-5">
        For questions about available positions, contact our hiring team.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a href={`tel:${SITE.phone.primaryTel}`} class="text-[#f5f5f4] font-bold no-underline hover:text-[#f5bd14]">
          {SITE.phone.primary} Ext: 3
        </a>
        <a href={`mailto:${SITE.emails.employment}`} class="text-[#f5f5f4] font-bold no-underline hover:text-[#f5bd14]">
          {SITE.emails.employment}
        </a>
      </div>
    </div>
  </div>
</section>
