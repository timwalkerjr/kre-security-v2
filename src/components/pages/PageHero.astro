---
interface Props {
  eyebrow: string;
  title: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { eyebrow, title, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<section class="relative isolate pt-[36px] pb-[56px]" data-ps="src/components/pages/PageHero.astro:section">
  <div class="max-w-[1180px] mx-auto px-6" data-ps="src/components/pages/PageHero.astro:container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[40px] items-start" data-ps="src/components/pages/PageHero.astro:grid">
      <div class="lg:col-span-7" data-ps="src/components/pages/PageHero.astro:copy">
        <div class="flex items-center gap-2 mb-4" data-ps="src/components/pages/PageHero.astro:eyebrow">
          <span class="w-4 h-[2px] bg-[#f5bd14]" data-ps="src/components/pages/PageHero.astro:bar"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase" data-ps="src/components/pages/PageHero.astro:label">
            {eyebrow}
          </span>
        </div>
        <h1 class="text-[36px] sm:text-[48px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.2px] mb-5" data-ps="src/components/pages/PageHero.astro:h1">
          {title}
        </h1>
        <div class="text-[#a8a29e] text-[17px] leading-[28px] mb-8 max-w-[560px] space-y-4" data-ps="src/components/pages/PageHero.astro:body">
          <slot name="lead" />
        </div>
        <div class="flex flex-wrap gap-3" data-ps="src/components/pages/PageHero.astro:actions">
          <a
            href={primaryHref}
            class="bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-[24px] py-[13px] rounded-[10px] no-underline hover:bg-[#e0ab10] transition-all"
            data-ps="src/components/pages/PageHero.astro:primary"
          >
            {primaryLabel}
          </a>
          {secondaryHref && secondaryLabel && (
            <a
              href={secondaryHref}
              class="border border-white/20 text-[#f5f5f4] font-semibold text-[14px] px-[24px] py-[13px] rounded-[10px] no-underline hover:border-[#f5bd14] transition-all"
              data-ps="src/components/pages/PageHero.astro:secondary"
            >
              {secondaryLabel}
            </a>
          )}
        </div>
      </div>
      <div class="lg:col-span-5" data-ps="src/components/pages/PageHero.astro:media">
        <slot name="media" />
      </div>
    </div>
  </div>
</section>
