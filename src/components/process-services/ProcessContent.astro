---
import { designAsset } from '@/config/site';

const documents = [
  'Letters of Civil Notice of Collection of a Debt',
  'Court Ordered Subpoenas',
  'Child Custody Paperwork',
  'Hearing Notices',
  'Landlord Tenant Dispute Notices',
  'And More',
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/process-services/ProcessContent.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">KRE Investigations Division</span>
        </div>
        <h2 class="text-[32px] sm:text-[36px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-5">
          Providing Process Services
        </h2>
        <p class="text-[#a8a29e] text-[16px] leading-[26px] mb-8">
          KRE Security Investigation division offers process services by the delivery of legal paperwork. We always provide the appropriate documentation to our clients. KRE works with local and national based law firms and private clients for their needs 24/7.
        </p>
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-4">Document Types We Serve</p>
        <div class="space-y-3 mb-8">
          {documents.map((doc) => (
            <div class="flex items-start gap-3 p-4 bg-white/[0.035] border border-white/[0.09] rounded-[12px] hover:border-[#f5bd14]/40 transition-colors">
              <span class="w-2 h-2 bg-[#f5bd14] shrink-0 mt-1 rounded-full"></span>
              <span class="text-[#f5f5f4] text-[14px]">{doc}</span>
            </div>
          ))}
        </div>
        <a href="/#contact" class="inline-block bg-white text-[#0a0a0a] font-bold text-[14px] px-8 py-4 rounded-[10px] no-underline hover:bg-[#e7e5e4]">
          Contact Us to Get Started
        </a>
      </div>
      <div class="space-y-5">
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
          <img src={designAsset('/images/lib/Business-Meeting-320.webp')} alt="Process services — business meeting" class="w-full h-auto object-cover rounded-[12px]" loading="lazy" />
        </div>
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7">
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Service Guarantee</p>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-4">
            All domestic and legal documents are properly served in accordance with your local guidelines. We ensure compliance and provide full documentation to every client.
          </p>
          <div class="pt-4 border-t border-white/[0.09]">
            <p class="text-[#a8a29e] text-[11px] font-bold uppercase tracking-widest m-0">Available</p>
            <p class="text-[#f5bd14] text-[28px] font-extrabold m-0 mt-1">24 / 7</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
