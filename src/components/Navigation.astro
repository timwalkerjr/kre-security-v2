---
// Net Express Navigation
// ps:header-variant — BaseLayout passes variant="solid" on pages whose source
// shows the header solid at the top; the scroll script below keeps it so.
const headerVariant =
  (Astro.props as { variant?: 'transparent' | 'solid' }).variant ??
  'transparent';

---

<header data-header-variant={headerVariant} id="navbar" class="sticky top-0 z-50 bg-[#091a2c]/85 backdrop-blur-md border-b border-white/[0.08]" data-ps="src/components/Navigation.astro:header">
  <div class="max-w-[1180px] mx-auto px-6 h-[68px] flex items-center justify-between" data-ps="src/components/Navigation.astro:container">
    <!-- Logo -->
    <a href="/#home" class="flex items-center no-underline shrink-0" data-ps="src/components/Navigation.astro:logo">
      <img
        src="https://pagesmith-cdn.com/726747c3/images/netexpress-logo-320.webp"
        alt="Net Express"
        width="169"
        height="31"
        class="h-[31px] w-[169px] object-contain"
        loading="eager" data-ps="src/components/Navigation.astro:d4d69x" />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-[24px]" aria-label="Main Navigation" data-ps="src/components/Navigation.astro:desktop-nav">
      <a href="/#services" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjs6">Services</a>
      <a href="/#why" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjs7">Why Net Express</a>
      <a href="/service-areas" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjs8">Service Area</a>
      <a href="/articles" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:articles-link">Articles</a>
      <a href="/#reviews" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjs9">Reviews</a>
      <a href="/#faq" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjsa">FAQ</a>
      <a href="/#contact" class="text-[14.88px] font-medium text-[#c4d1dd] hover:text-white transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjsb">Contact</a>
    </nav>

    <!-- Desktop Right CTA & Phone -->
    <div class="hidden md:flex items-center gap-5" data-ps="src/components/Navigation.astro:right-cta">
      <div class="text-[14.88px] text-[#c4d1dd]" data-ps="src/components/Navigation.astro:gqvsdc">
        Call <a href="tel:+18553132300" class="font-bold text-white hover:text-[#94e760] transition-colors no-underline" data-ps="src/components/Navigation.astro:7vkjsc">(855) 313-2300</a>
      </div>
      <a
        href="/#contact"
        class="bg-white text-[#0a1a2e] font-semibold text-[15.2px] px-[18px] py-[9px] rounded-[10px] hover:bg-[#eef3f7] hover:shadow transition-all no-underline shrink-0"
       data-ps="src/components/Navigation.astro:7vkjsd">
        Get a Quote
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-button"
      type="button"
      class="lg:hidden p-2 text-[#c4d1dd] hover:text-white transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-ps="src/components/Navigation.astro:mobile-btn"
    >
      <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-[#091a2c]/95 border-b border-white/[0.08] backdrop-blur-xl px-6 py-5 flex flex-col gap-3"
    role="navigation"
    aria-label="Mobile navigation"
    data-ps="src/components/Navigation.astro:mobile-menu"
  >
    <a href="/#services" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjse">Services</a>
    <a href="/#why" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:7vkjsf">Why Net Express</a>
    <a href="/service-areas" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:kd8n5z">Service Area</a>
    <a href="/articles" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:mobile-articles">Articles</a>
    <a href="/#reviews" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:kd8n5y">Reviews</a>
    <a href="/#faq" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:kd8n5x">FAQ</a>
    <a href="/#contact" class="text-[#c4d1dd] font-medium text-[16px] py-2 no-underline hover:text-white transition-colors" data-ps="src/components/Navigation.astro:kd8n5w">Contact</a>
    <div class="pt-3 border-t border-white/[0.08] flex flex-col gap-3" data-ps="src/components/Navigation.astro:gqvsdd">
      <div class="text-[15px] text-[#c4d1dd]" data-ps="src/components/Navigation.astro:gqvsde">
        Call <a href="tel:+18553132300" class="font-bold text-white hover:text-[#94e760] no-underline" data-ps="src/components/Navigation.astro:kd8n5v">(855) 313-2300</a>
      </div>
      <a
        href="/#contact"
        class="bg-white text-[#0a1a2e] text-center font-semibold text-[15.2px] px-[18px] py-[11px] rounded-[10px] hover:bg-[#eef3f7] transition-all no-underline"
       data-ps="src/components/Navigation.astro:kd8n5u">
        Get a Quote
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  function toggleMenu() {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'true');
    }
  }

  mobileMenuButton?.addEventListener('click', toggleMenu);
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuButton?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
