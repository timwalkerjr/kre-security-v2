---
import { SITE, designAsset } from '@/config/site';

const eventTypes = [
  'Concerts',
  'High School & College Sporting Events',
  'Large-Scale Facility Ingress/Egress',
  'Business Parking & Traffic Management',
  'Parking Garages',
  'Churches & Community Events',
  'Events 200–15,000 Vehicles',
  'Large-Scale Events 35,000+ Attendees',
];

const equipment = [
  'Private radios for real-time coordination',
  'Traffic signal hand wands',
  'Traffic cones and DOT-approved signs',
  'ANSI and DOT approved reflective vests',
  'Portable lighting systems',
  'Roadway flairs',
  'Highly-visible uniformed staff',
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/event-traffic-control/TrafficContent.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 items-start mb-16">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
          <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Traffic Safety Specialists</span>
        </div>
        <h2 class="text-[32px] sm:text-[36px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-6">
          Professional Traffic Control Across Eastern PA
        </h2>
        <div class="space-y-4 text-[#a8a29e] text-[15px] leading-[24px]">
          <p class="m-0">
            KRE Security provides traffic control services for Concerts, High School/College sporting events, facility ingress and egress, to assist with traffic moving in and out of businesses, parking garages, churches, events, and more.
          </p>
          <p class="m-0">
            Our officers comply with local and state traffic laws to keep traffic flow moving and keep drivers, cyclists, and pedestrians safe. KRE staff retain professional based instruction and certification to provide professional based services for any event across Eastern Pennsylvania.
          </p>
          <p class="m-0">
            KRE works alongside Local and State Police in addition to numerous emergency service organizations during our events.
          </p>
          <p class="m-0">
            Custom based traffic control service and safety plans are created with client based input and implementation. The safe and systematic parking of vehicles and event traffic management is crucial to the ultimate safety and enjoyment of an event. Done correctly, it will alleviate congestion and frustration, bringing a positive effect and potential for repeat business.
          </p>
        </div>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
        <img src={designAsset('/images/lib/traffic-control_JPG-320.webp')} alt="KRE Security traffic control services" class="w-full max-w-[320px] h-auto object-cover rounded-[12px]" loading="lazy" />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5 mb-12">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Events We Serve</p>
        <h3 class="text-[18px] font-bold text-[#f5f5f4] mb-5">Event Types</h3>
        <ul class="space-y-3 m-0 p-0 list-none">
          {eventTypes.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Field Equipment</p>
        <h3 class="text-[18px] font-bold text-[#f5f5f4] mb-5">Equipment Provided</h3>
        <ul class="space-y-3 m-0 p-0 list-none">
          {equipment.map((item) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-2 h-2 bg-[#f5bd14] shrink-0 rounded-full"></span>
              <span class="text-[#a8a29e] text-[14px]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-8 lg:p-10 text-center">
      <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Request a Custom Traffic Plan</p>
      <h3 class="text-[28px] font-extrabold text-[#f5f5f4] mb-4">Planning an Event?</h3>
      <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-6 max-w-xl mx-auto">
        Custom traffic control service and safety plans are created with client-based input and implementation. Contact us today to discuss your event needs.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-8 py-4 rounded-[10px] no-underline hover:bg-[#e0ab10]">
          Get a Free Consultation
        </a>
        <a href={`tel:${SITE.phone.primaryTel}`} class="border border-white/20 text-[#f5f5f4] font-semibold text-[14px] px-8 py-4 rounded-[10px] no-underline hover:border-[#f5bd14]">
          {SITE.phone.primary}
        </a>
      </div>
    </div>
  </div>
</section>
