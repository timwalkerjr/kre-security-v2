---
import PageHero from '@/components/pages/PageHero.astro';
import { SITE, designAsset } from '@/config/site';
---

<PageHero
  eyebrow="Industrial Security Division"
  title="Warehouse & Distribution Center Security"
  primaryHref="/contact/"
  primaryLabel="Contact Us Today"
  secondaryHref={`tel:${SITE.phone.primaryTel}`}
  secondaryLabel={SITE.phone.primary}
>
  <Fragment slot="lead">
    <p class="m-0">
      KRE has extensive experience providing security programs and services to distribution center clients. We demonstrate a vast understanding of the unique challenges and common concerns associated with this market.
    </p>
  </Fragment>
  <Fragment slot="media">
    <div class="space-y-3">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
        <img src={designAsset('/images/lib/Truck-and-Warehouse-320.webp')} alt="Truck and warehouse facility secured by KRE Security" class="w-full max-w-[320px] h-auto object-cover rounded-[12px] mx-auto" loading="eager" />
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden p-2">
        <img src={designAsset('/images/lib/20220228_124523-320.webp')} alt="KRE Security distribution center patrol" class="w-full max-w-[320px] h-auto object-cover rounded-[12px] mx-auto" loading="lazy" />
      </div>
    </div>
  </Fragment>
</PageHero>
