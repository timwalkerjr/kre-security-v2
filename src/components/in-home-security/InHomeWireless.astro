---
import { designAsset } from '@/config/site';

const galleryImages = [
  { src: '/images/lib/39725c_43eab39063f74cca917dd0648078034d-mv2-184.webp', alt: 'Wireless home security device' },
  { src: '/images/lib/39725c_9e8dce94da104095b6cf86e34e32c8de-mv2-184.webp', alt: 'Home security panel' },
  { src: '/images/lib/39725c_87063351514d41efb6ef1dddf67510f3-mv2-184.webp', alt: 'Security sensor' },
  { src: '/images/lib/39725c_ed2a42e00c18406a905836f2db8b6160-mv2-184.webp', alt: 'Smart security device' },
  { src: '/images/lib/39725c_53ffb065439f4ce79efda3cb83bdd75e-mv2-184.webp', alt: 'Home security equipment' },
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/in-home-security/InHomeWireless.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="flex items-center gap-2 mb-3">
      <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
      <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Wireless Advantage</span>
    </div>
    <h2 class="text-[32px] sm:text-[36px] font-extrabold text-[#f5f5f4] leading-[1.08] mb-8">
      Why Go Wireless for Your Home Security System?
    </h2>

    <div class="grid lg:grid-cols-3 gap-5 mb-12">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Real-Time Awareness</p>
        <p class="text-[#a8a29e] text-[14px] leading-[22px] m-0">
          Wireless systems are more secure and allow you to have real-time awareness and alerts from your home via your mobile app. These systems are increasingly tamper proof because there are no exposed lines that can be cut from outside.
        </p>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Remote Monitoring</p>
        <p class="text-[#a8a29e] text-[14px] leading-[22px] m-0">
          Your wireless system comes with a phone app you can use to monitor surveillance footage live. Check who's at the door, monitor kids in the backyard, or check on pets while at work — from wherever you are.
        </p>
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
        <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">Easy Expansion</p>
        <p class="text-[#a8a29e] text-[14px] leading-[22px] m-0">
          As your family grows and evolves, your security needs may as well. It's easy to add new cameras with a wireless system. Let us know what you're looking to protect and we'll help create a system that's just right for you.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mb-10">
      {galleryImages.map((img) => (
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] overflow-hidden">
          <img src={designAsset(img.src)} alt={img.alt} class="max-w-[184px] h-auto object-cover" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div>
        <p class="text-[#f5f5f4] text-[18px] font-bold m-0 mb-1">Ready to Secure Your Home?</p>
        <p class="text-[#a8a29e] text-[14px] m-0">Contact KRE Security to discuss a wireless system tailored to your needs.</p>
      </div>
      <a href="/contact/" class="bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-7 py-3 rounded-[10px] no-underline hover:bg-[#e0ab10] whitespace-nowrap">
        Contact Us Today
      </a>
    </div>
  </div>
</section>
