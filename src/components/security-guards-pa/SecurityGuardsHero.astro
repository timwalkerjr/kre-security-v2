---
import PageHero from '@/components/pages/PageHero.astro';
import { designAsset } from '@/config/site';
---

<PageHero
  eyebrow="Guard Pro Accountability System Active"
  title="Security Guard Services Eastern Pennsylvania"
  primaryHref="/contact/"
  primaryLabel="Contact Us Today"
  secondaryHref="/armed-security-pa/"
  secondaryLabel="Armed Security"
>
  <Fragment slot="lead">
    <p class="m-0">
      KRE Security LLC. provides a variety of both public and private event, unarmed or armed security guard services across Pennsylvania. We provide short term, long term, and permanent security guard services to our clients 24/7.
    </p>
    <p class="m-0">
      Our security officers provide a public security presence which allows our customers the peace of mind knowing that their property is protected at all hours.
    </p>
  </Fragment>
  <Fragment slot="media">
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden">
        <img src={designAsset('/images/lib/39725c_ae664ab23abd45948c48b214d6897bcb-mv2-262.webp')} alt="Private armed security companies in PA" class="w-full h-48 object-cover" loading="eager" />
      </div>
      <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] overflow-hidden">
        <img src={designAsset('/images/lib/Attachment-301.webp')} alt="KRE Security guard services" class="w-full h-48 object-cover" loading="eager" />
      </div>
    </div>
  </Fragment>
</PageHero>
