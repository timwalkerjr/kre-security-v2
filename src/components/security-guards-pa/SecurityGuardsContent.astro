---
import { designAsset } from '@/config/site';

const benefits = [
  { num: '01', title: 'Focus on What You Do Best', desc: 'When you leave the security function up to someone else, you and your company can concentrate your resources on the business. Having a security guard company control the security duties, you can get back to taking care of your customers.' },
  { num: '02', title: 'Leave It to the Experts', desc: 'By contracting our security guard service, you can rest assured that we have invested copious amounts of time training our staff, researching the best equipment to use, and making sure all of our (and your) bases are covered.' },
  { num: '03', title: 'Free Up Your Resources', desc: 'Outsourcing the security function of your company will allow you to free up your personnel that are serving this duty to perform other, potentially more important, actions. Keep your focus on efficiency of your process, customer service and the final product.' },
  { num: '04', title: 'Reduce Risk', desc: 'Once a contract is signed, we are accountable for the security of your company and/or the details outlined in the contract. Breathe a sigh of relief when that worry is off your plate and know you are in good hands.' },
];

const serviceTypes = [
  'Agriculture', 'Apartment Complexes', 'Armed/Unarmed Security Guards', 'Asset Protection',
  'Bar/Nightclub Security', 'College/Universities', 'Commercial Real Estate', 'Construction Security',
  'Distribution Facilities', 'Energy & Utilities', 'Emergency Storm Response Security', 'Facility Security',
  'Film Production Site Security', 'Fire Watch Security Services', 'Government Services',
  'Healthcare Facilities', 'Industrial Park Security (24/7)', 'Large Event Security',
  'Long Term Contracts', 'Malls', 'Manufacturing & Industrial', 'Mobile Security Patrol',
  'National Security Contracts', 'Night Watchmen', 'Office Buildings', 'On-site Security',
  'Personal Protection', 'Private Parking Enforcement', 'Residential Communities',
  'Restaurant Maintenance', 'Retail Security', 'School Events', 'Shopping Centers',
  'Special Event Parking Security', 'Temporary and Long-term Security', 'Uniformed Patrol Services',
  'Warehouse Security (24/7)',
];

const galleryImages = [
  { src: '/images/lib/39725c_57d30354f75c459a8ff7493a8ed2e778-mv2-239.webp', alt: 'Security companies in PA' },
  { src: '/images/lib/39725c_6af31e81bf8740d4b966aa8251765f40-mv2-225.webp', alt: 'Security guard companies in Reading' },
  { src: '/images/lib/39725c_0e10faf1585c4f2c8fbd4262dc8e6a54-mv2-225.webp', alt: 'Armed & unarmed security services Philadelphia PA' },
  { src: '/images/lib/39725c_41f7dc4afc7d4747817dba023b4d5ddd-mv2-225.webp', alt: 'Best private investigator eastern PA' },
  { src: '/images/lib/39725c_cdcbaf3497194856a579bc8bfbcfe3c2-mv2-225.webp', alt: 'Armed security guard Lehigh Valley' },
];
---

<section class="relative isolate py-[72px] border-t border-white/[0.06]" data-ps="src/components/security-guards-pa/SecurityGuardsContent.astro:section">
  <div class="max-w-[1180px] mx-auto px-6">
    <div class="mb-16">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Why Outsource?</span>
      </div>
      <h2 class="text-[32px] sm:text-[40px] font-extrabold text-[#f5f5f4] leading-[1.08] tracking-[-1.1px] mb-8">Benefits of Outsourcing Security Guard Services</h2>
      <div class="grid md:grid-cols-2 gap-5">
        {benefits.map((b) => (
          <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-6">
            <span class="text-[#f5bd14] text-[28px] font-extrabold block mb-2">{b.num}</span>
            <h3 class="text-[18px] font-bold text-[#f5f5f4] mb-2">{b.title}</h3>
            <p class="text-[#a8a29e] text-[15px] leading-[24px] m-0">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="bg-white/[0.035] border border-white/[0.09] rounded-[16px] p-8 lg:p-10 mb-16">
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <p class="text-[#f5bd14] text-[11px] font-bold uppercase tracking-widest mb-3">KRE Accountability Technology</p>
          <h2 class="text-[28px] font-extrabold text-[#f5f5f4] mb-4">The Guard Pro System</h2>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-3">The Guard Pro System insures quality control and accountability of the guards and the client that their needs are being met by our security guard professionals.</p>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] mb-3">Guard Pro systems allow our managers to meet with both the client and the security guard to ensure proper rounds are conducted at each shift. KRE managers will provide written reports to the client in order to provide better manager-client relations.</p>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] m-0">This is part of KRE Security’s customer service satisfaction guarantee. We are willing to meet any needs that the client may have while knowing their property is protected.</p>
        </div>
        <div class="space-y-4">
          <p class="text-[#a8a29e] text-[15px] leading-[24px] border-l-2 border-[#f5bd14] pl-4 m-0">Our security guard service staff maintains a professional demeanor at all times. Our officers hold current emergency services training, such as CPR and First Aid.</p>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] border-l-2 border-[#f5bd14] pl-4 m-0">KRE Security officers have an ongoing relationship with local level police, fire and EMS agencies throughout the area.</p>
          <p class="text-[#a8a29e] text-[15px] leading-[24px] border-l-2 border-[#f5bd14] pl-4 m-0">KRE Security employs top quality security professionals who have extensive experience working in the criminal and public safety fields.</p>
        </div>
      </div>
    </div>

    <div class="mb-12">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-4 h-[2px] bg-[#f5bd14]"></span>
        <span class="text-[#f5bd14] text-[13.6px] font-semibold tracking-wider uppercase">Full Spectrum Coverage</span>
      </div>
      <h2 class="text-[28px] font-extrabold text-[#f5f5f4] mb-6">Providing Security Guard Services for:</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2">
        {serviceTypes.map((type) => (
          <div class="flex items-center gap-2 border border-white/[0.09] bg-white/[0.035] rounded-[10px] p-2.5">
            <span class="w-1.5 h-1.5 bg-[#f5bd14] shrink-0 rounded-full"></span>
            <span class="text-[#a8a29e] text-[12px] leading-tight">{type}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-10">
      {galleryImages.map((img) => (
        <div class="bg-white/[0.035] border border-white/[0.09] rounded-[12px] overflow-hidden">
          <img src={designAsset(img.src)} alt={img.alt} class="w-full h-32 object-cover" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="text-center">
      <a href="/contact/" class="inline-block bg-[#f5bd14] text-[#0a0a0a] font-bold text-[14px] px-10 py-4 rounded-[10px] no-underline hover:bg-[#e0ab10]">
        Contact Us Today to Get Started
      </a>
    </div>
  </div>
</section>
